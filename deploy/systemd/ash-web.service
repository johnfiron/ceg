[Unit]
Description=ASH web dashboard
PartOf=ash.target
After=network-online.target ash-runner.service
Wants=ash-runner.service

[Service]
Type=simple
User=ash-web
Group=ash-readers
WorkingDirectory=/opt/ash/current
Environment=CEG_ENV=production
Environment=CEG_PROCESS_ROLE=web
Environment=CEG_DATA_DIR=/var/lib/ash
Environment=CEG_CONFIG_FILE=/etc/ash/config.web.json
Environment=CEG_ALLOW_BROKER_ORDERS=false
ExecStart=/opt/ash/venv/bin/gunicorn --chdir /opt/ash/current --workers 1 --bind 127.0.0.1:8765 --access-logfile - --error-logfile - app:app
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/ash /etc/ash/config.web.json
ReadWritePaths=/var/lib/ash/arena.db-shm
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
RestrictNamespaces=true
RestrictRealtime=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ash-web

[Install]
WantedBy=ash.target
