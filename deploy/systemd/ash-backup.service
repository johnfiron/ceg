[Unit]
Description=ASH consistent SQLite backup
After=ash-runner.service

[Service]
Type=oneshot
User=ash-runner
Group=ash-runner
SupplementaryGroups=ash-readers
WorkingDirectory=/opt/ash/current
Environment=CEG_ENV=production
Environment=CEG_PROCESS_ROLE=runner
Environment=CEG_DATA_DIR=/var/lib/ash
Environment=CEG_CONFIG_FILE=/etc/ash/config.production.json
Environment=CEG_ALLOW_BROKER_ORDERS=false
Environment=RCLONE_CONFIG=/var/lib/ash/offsite/rclone.conf
EnvironmentFile=-/etc/ash/backup.env
ExecStart=/usr/local/sbin/ash-backup-offsite
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ash
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ash-backup
