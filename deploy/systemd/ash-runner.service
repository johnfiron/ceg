[Unit]
Description=ASH trading runner
PartOf=ash.target
After=network-online.target

[Service]
Type=notify
NotifyAccess=main
User=ash-runner
Group=ash-runner
SupplementaryGroups=ash-readers
WorkingDirectory=/opt/ash/current
Environment=CEG_ENV=production
Environment=CEG_PROCESS_ROLE=runner
Environment=CEG_DATA_DIR=/var/lib/ash
Environment=CEG_CONFIG_FILE=/etc/ash/config.production.json
Environment=CEG_ALLOW_BROKER_ORDERS=false
ExecStart=/opt/ash/venv/bin/python runner.py
Restart=always
RestartSec=5
WatchdogSec=100
TimeoutStartSec=180
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ash
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
RestrictNamespaces=true
RestrictRealtime=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ash-runner

[Install]
WantedBy=ash.target
